# Copy to local.properties (git-ignored) and enter your local credentials.
DB_URL=jdbc:postgresql://localhost:5433/python_lecture
DB_USERNAME=your_local_database_user
DB_PASSWORD=your_local_database_password
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_base64_secret
COOKIE_SECURE=false
PORT=8090
